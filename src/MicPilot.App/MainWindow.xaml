<Window x:Class="MicPilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MicPilot.App" xmlns:controls="clr-namespace:MicPilot.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MicPilot" Width="1320" Height="920" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="14" Icon="Assets/MicPilot.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <local:NonEmptyVisibilityConverter x:Key="NonEmpty"/>
  <Style x:Key="NavStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Root" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="MetricStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="ScreenStyle" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Padding" Value="0,0,8,0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><Image Source="Assets/MicPilot.png" Width="26" Height="26" Margin="0,0,10,0"/><TextBlock Text="MicPilot" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Студия микрофона" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" AutomationProperties.Name="Свернуть"><Path Data="M0,0 L10,0" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/></Button><Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" AutomationProperties.Name="Развернуть"><Path Data="M0,0 L10,0 10,10 0,10 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.3"/></Button><Button Style="{StaticResource WindowButtonStyle}" Click="Close_Click" AutomationProperties.Name="Закрыть"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/></Button></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,28,16,20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" Margin="8,0,0,18"/>
      <RadioButton x:Name="HomeNav" Style="{StaticResource NavStyle}" GroupName="Navigation" IsChecked="True" Checked="Navigation_Checked" Tag="0"><StackPanel Orientation="Horizontal"><Path Data="M8,1 C5,1 5,4 5,7 L5,12 C5,16 11,16 11,12 L11,7 C11,4 11,1 8,1 M2,10 L2,13 C2,21 14,21 14,13 L14,10 M8,20 L8,24 M4,24 L12,24" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="22" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Микрофон" VerticalAlignment="Center"/></StackPanel></RadioButton>
      <RadioButton x:Name="TuneNav" Style="{StaticResource NavStyle}" GroupName="Navigation" Checked="Navigation_Checked" Tag="1"><StackPanel Orientation="Horizontal"><Path Data="M1,5 L23,5 M1,12 L23,12 M1,19 L23,19 M7,2 L7,8 M17,9 L17,15 M10,16 L10,22" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="22" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Обработка" VerticalAlignment="Center"/></StackPanel></RadioButton>
      <RadioButton x:Name="CalibNav" Style="{StaticResource NavStyle}" GroupName="Navigation" Checked="Navigation_Checked" Tag="2"><StackPanel Orientation="Horizontal"><Path Data="M6,1 L16,1 M8,1 L8,9 2,20 Q1,23 5,23 L19,23 Q23,23 22,20 L14,9 14,1 M5,16 L19,16" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="22" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Автонастройка" VerticalAlignment="Center"/></StackPanel></RadioButton>
      <RadioButton x:Name="RouteNav" Style="{StaticResource NavStyle}" GroupName="Navigation" Checked="Navigation_Checked" Tag="3"><StackPanel Orientation="Horizontal"><Path Data="M2,5 L8,5 8,11 2,11 Z M16,2 L22,2 22,8 16,8 Z M16,16 L22,16 22,22 16,22 Z M8,8 L12,8 12,5 16,5 M12,8 L12,19 16,19" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="22" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Подключение" VerticalAlignment="Center"/></StackPanel></RadioButton>
     </StackPanel>
     <Border Grid.Row="2" Background="{StaticResource InputBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="ТОЛЬКО ЛОКАЛЬНО" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Без облака и отправки голоса. GPU не нужен." Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="28,24,20,16" MaxWidth="1320"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Твой голос. Чище." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Один обработанный микрофон для игр, общения и записи." Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="12,7" VerticalAlignment="Top" Margin="16,6,0,0"><TextBlock Text="MICPILOT / 01" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/></Border></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="216"/><ColumnDefinition Width="16"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
     <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusDetail}" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel>
     <TextBlock Grid.Column="1" Text="Профиль звучания" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="ProfileBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Профиль звучания"/>
     <Button x:Name="EngineButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding StartLabel}" Command="{Binding StartCommand}" Padding="12,0"/>
    </Grid></Border>
    <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,16" Visibility="{Binding Notice,Converter={StaticResource NonEmpty}}"><TextBlock Text="{Binding Notice}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" LineHeight="19"/></Border>
    <TabControl Grid.Row="3" x:Name="Screens" SelectedIndex="{Binding PageIndex}"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
     <TabItem Header="Микрофон"><ScrollViewer Style="{StaticResource ScreenStyle}"><StackPanel>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
       <TextBlock Text="Физический микрофон" Style="{StaticResource LabelStyle}"/><TextBlock Grid.Column="2" Text="Выход в приложения" Style="{StaticResource LabelStyle}"/>
       <ComboBox x:Name="InputBox" Grid.Row="1" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeDevices}" AutomationProperties.Name="Физический микрофон" ToolTip="{Binding SelectedInput.Name}"/>
       <ComboBox x:Name="OutputBox" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeDevices}" AutomationProperties.Name="Виртуальный аудиовыход" ToolTip="{Binding SelectedOutput.Name}"/>
       <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="4" Command="{Binding RefreshCommand}" Padding="0" ToolTip="Обновить список устройств" AutomationProperties.Name="Обновить аудиоустройства"><Path Data="M17,5 C12,-2 1,1 1,10 C1,20 15,23 20,13 M17,0 L17,6 11,6" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.7"/></Button>
       <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="В Discord, игре, Telegram и OBS выберите CABLE Output. Исходный PD200X останется необработанным входом." Style="{StaticResource HelperTextStyle}" Margin="0,12,0,0"/>
      </Grid></Border>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="296"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Живой уровень" Style="{StaticResource SectionTitleStyle}"/><TextBlock Grid.Column="1" Text="{Binding InputLevel}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" VerticalAlignment="Center"/></Grid><controls:HistoryGraph x:Name="LevelGraph" IsLevel="True" Height="144" Margin="0,16,0,12" AutomationProperties.Name="История уровня входа, последние 12 секунд"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Вход" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding InputLevel}" FontSize="17"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Обработанный выход" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding OutputLevel}" FontSize="17"/></StackPanel></Grid></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Контроль эфира" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18"/><CheckBox Content="Заглушить микрофон" IsChecked="{Binding Muted}" Margin="0,0,0,14"/><CheckBox Content="Обойти фильтры" IsChecked="{Binding Bypass}" Margin="0,0,0,18"/><TextBlock Text="При обходе защитный лимитер остаётся включён. Это не аппаратный mute Maono." Style="{StaticResource HelperTextStyle}"/><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14"/><TextBlock Text="{Binding EngineText}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding ReductionText}" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid>
      <UniformGrid Columns="3" Margin="0,0,-16,16"><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Ресурсы приложения" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding CpuText}" Style="{StaticResource MetricStyle}"/><TextBlock Text="{Binding RamText}" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Расчётная задержка" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetricStyle}"/><TextBlock Text="Не измерение конца в конец" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Время обработки" Style="{StaticResource LabelStyle}"/><TextBlock Text="{Binding DspText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Реальный замер блока" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid>
      <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Нагрузка CPU" Style="{StaticResource SectionTitleStyle}"/><TextBlock Grid.Column="1" Text="1 замер / с" Style="{StaticResource HelperTextStyle}"/></Grid><controls:HistoryGraph x:Name="CpuGraph" Height="120" Margin="0,16,0,8" AutomationProperties.Name="Нагрузка приложения на CPU, график от 0 до 10 процентов"/><TextBlock Text="{Binding DiagnosticsText}" Style="{StaticResource HelperTextStyle}"/><TextBlock Text="CPU — доля общей мощности процессора. Шкала графика 0–10%; точное значение показано выше." Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Обработка"><ScrollViewer Style="{StaticResource ScreenStyle}"><StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Звуковая цепочка" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Изменения слышны сразу при активной обработке. Пресеты можно сохранить под своим названием." Style="{StaticResource HelperTextStyle}" Margin="0,6,16,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox Content="RNNoise" IsChecked="{Binding NoiseEnabled}" Margin="0,0,0,8"/><CheckBox Content="Экспандер" IsChecked="{Binding GateEnabled}" Margin="0,0,0,8"/><CheckBox Content="Компрессор" IsChecked="{Binding CompressorEnabled}"/></StackPanel></Grid>
      <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,18"/><ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="38"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/><Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Min}" Maximum="{Binding Max}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Hint}" Style="{StaticResource HelperTextStyle}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Профили микрофона" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Название своего профиля"/><Button Grid.Column="2" Content="Сохранить профиль" Command="{Binding SaveCommand}"/></Grid><WrapPanel Margin="0,12,0,0"><Button Content="Импорт JSON" Command="{Binding ImportCommand}" Margin="0,0,12,8"/><Button Content="Экспорт JSON" Command="{Binding ExportCommand}" Margin="0,0,12,8"/><Button Content="Сбросить параметры профиля" Command="{Binding ResetCommand}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Автонастройка"><ScrollViewer Style="{StaticResource ScreenStyle}"><StackPanel>
      <TextBlock Text="Умная настройка под твою комнату" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Локальный анализ аудио подбирает стартовые параметры. Это не обучение голоса и не гарантия идеального звука." Style="{StaticResource HelperTextStyle}" Margin="0,6,0,16"/>
      <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16"><TextBlock Text="Перед записью: остановите обработку MicPilot, отключите эффекты Maono и других приложений. Говорите в обычном положении. Для прослушивания используйте наушники." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" LineHeight="20"/></Border>
      <UniformGrid Columns="3" Margin="0,0,-16,16"><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="01 / КОМНАТА" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="Фоновый шум" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Не говорите 7 секунд. Оставьте компьютер в обычном режиме." Style="{StaticResource HelperTextStyle}" MinHeight="64"/><Button Content="Записать фон" Command="{Binding RoomCommand}" Margin="0,12,0,12"/><TextBlock Text="{Binding RoomStatus}" Style="{StaticResource HelperTextStyle}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="02 / ПОМЕХИ" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="Клавиатура и мышь" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="8 секунд печатайте и кликайте. В этом образце не говорите." Style="{StaticResource HelperTextStyle}" MinHeight="64"/><Button Content="Записать помехи" Command="{Binding KeyboardCommand}" Margin="0,12,0,12"/><TextBlock Text="{Binding KeyboardStatus}" Style="{StaticResource HelperTextStyle}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="03 / ГОЛОС" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="Твоя обычная речь" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="30 секунд: тихо, обычно и громко. Добавьте слова с «П/Б/С/Ш»." Style="{StaticResource HelperTextStyle}" MinHeight="64"/><Button Content="Записать голос" Command="{Binding SpeechCommand}" Margin="0,12,0,12"/><TextBlock Text="Можно загрузить аудиофайл" Style="{StaticResource HelperTextStyle}"/></StackPanel></Border></UniformGrid>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><WrapPanel><Button Content="Загрузить свою запись" Command="{Binding LoadCommand}" Margin="0,0,12,8"/><Button Content="Подобрать настройки" Command="{Binding AnalyzeCommand}" Margin="0,0,12,8"/><Button Content="Отмена" Command="{Binding CancelCommand}" Margin="0,0,0,8"/></WrapPanel><ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" Margin="0,8,0,12"/><TextBlock Text="{Binding CalibrationStatus}" Style="{StaticResource HelperTextStyle}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Что показал анализ" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding AnalysisText}" Style="{StaticResource HelperTextStyle}" Margin="0,14,0,18"/><Button Content="Применить предложение" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Послушай до / после" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Одинаковая громкость для честного сравнения. Прослушивание идёт в системные наушники/динамики, не в CABLE." Style="{StaticResource HelperTextStyle}" Margin="0,6,0,16"/><WrapPanel><Button Content="Оригинал" Command="{Binding DryCommand}" Margin="0,0,12,8"/><Button Content="С обработкой" Command="{Binding WetCommand}" Margin="0,0,12,8"/><Button Content="Стоп" Command="{Binding StopPreviewCommand}" Margin="0,0,12,8"/><Button Content="Сохранить WAV" Command="{Binding ExportAudioCommand}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Подключение"><ScrollViewer Style="{StaticResource ScreenStyle}"><StackPanel><TextBlock Text="Один звук — в нужных приложениях" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="MicPilot не меняет устройства Windows и настройки других приложений без вашего действия." Style="{StaticResource HelperTextStyle}" Margin="0,6,0,16"/><Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="01  В MicPilot" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Вход: физический PD200X. Выход: CABLE Input. Нажмите «Включить микрофон»." Style="{StaticResource HelperTextStyle}" Margin="0,10,0,0"/><TextBlock Text="02  В Discord / Valorant / Telegram" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="Выберите CABLE Output как устройство ввода. Для начала сравните без дополнительного шумоподавления и автоматической громкости этих приложений." Style="{StaticResource HelperTextStyle}" Margin="0,10,0,0"/><TextBlock Text="03  В OBS" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="Добавьте «Захват входного аудиопотока» → CABLE Output. Не включайте одновременно необработанный PD200X: иначе запишутся два голоса. Для проверки достаточно локальной записи, стрим не нужен." Style="{StaticResource HelperTextStyle}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Важно для стабильного звука" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="• Не направляйте CABLE Output обратно в MicPilot.&#10;• VoiceMorph / VoiceBridge не должны одновременно выводить звук в тот же кабель.&#10;• После остановки MicPilot кабель не получает ваш голос.&#10;• Усиление входа здесь цифровое. Перегруз самого Maono нужно устранять на микрофоне.&#10;• Сильные «П/Б» требуют также правильного положения и поп-фильтра." Style="{StaticResource HelperTextStyle}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EngineText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Настройки локально · обработка не запускается автоматически" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
